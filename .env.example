VERILEGAL_ENV=dev
VERILEGAL_QDRANT_URL=http://localhost:6333
VERILEGAL_DATA_DIR=data
VERILEGAL_REPORTS_DIR=reports

# Ingestion
VERILEGAL_MAX_CHUNK_CHARS=1800         # ≈ 450 BGE-M3 tokens; longer paragraphs split per point

# Compute (PROJECT.md 7.9)
VERILEGAL_DEVICE=auto                  # auto | cuda | cpu
VERILEGAL_EMBEDDER=bge-m3              # mistral-embed adapter is planned, not implemented
VERILEGAL_EMBEDDING_MODEL_NAME=BAAI/bge-m3
VERILEGAL_EMBED_BATCH_SIZE=16
VERILEGAL_RERANK_BATCH_SIZE=8
VERILEGAL_MAX_SEQ_LENGTH=512
VERILEGAL_DOCLING_DEVICE=cpu           # keep Docling off the 4 GB GPU
VERILEGAL_RERANKER_ENABLED=true
VERILEGAL_RETRIEVAL_TOP_K=20
VERILEGAL_RERANK_TOP_N=5

# Sparse retrieval (CPU); use the same configuration for indexing and questions.
VERILEGAL_SPARSE_MODEL_NAME=Qdrant/bm25
VERILEGAL_SPARSE_LANGUAGE=french
VERILEGAL_SPARSE_BATCH_SIZE=64
VERILEGAL_BM25_K=1.2
VERILEGAL_BM25_B=0.75
VERILEGAL_BM25_AVG_LEN=256              # fixed initial length-normalization parameter

# LLM (Mistral free Experiment tier during development)
VERILEGAL_LLM_PROVIDER=mistral
VERILEGAL_LLM_JUDGE_MODEL=mistral-large-latest
VERILEGAL_LLM_FAST_MODEL=mistral-small-latest
VERILEGAL_LLM_MAX_CONCURRENCY=1        # raise only on a paid tier
VERILEGAL_LLM_MAX_RETRIES=6            # exponential backoff on HTTP 429 / 5xx
MISTRAL_API_KEY=

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
